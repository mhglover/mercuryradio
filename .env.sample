# Copy to .env and fill in. .env is gitignored — never commit it.
DISCORD_TOKEN=your-bot-token-from-the-discord-dev-portal
# Per-server config lives in the DB (the guilds table) — ONE process serves many
# servers. Add a server by running /setup in it (admin), no redeploy. The three
# vars below are OPTIONAL and only SEED the first server from env on a fresh DB,
# for a simple single-server deploy; leave them blank and use /setup instead.
GUILD_ID=
VOICE_CHANNEL_ID=
NOWPLAYING_CHANNEL_ID=
# Host path to your music library (scanned recursively for audio files).
# In Docker this is the host path that gets mounted read-only to /music.
MUSIC_DIR=/path/to/your/music
# Where the SQLite DB (library + ratings) lives. Local default is ./data;
# in Docker, DATA_DIR is the host dir mounted to /data and DB_PATH=/data/mercuryradio.db.
# DATA_DIR=/path/to/a/writable/dir
# Writable ingest dir for /add uploads (MUSIC_DIR stays read-only). Defaults to
# an "added" subdir next to the DB (inside /data), so it works with no extra mount.
# Set it to a dedicated writable path/mount to keep uploads out of the DB volume.
# ADDED_DIR=/added
# Cap on a /youtube pull, in minutes (default 20). Over-long videos are rejected
# at the metadata pre-fetch, before any download.
# MAX_ADD_MINUTES=20
# For the Plex ★ seed (seed_plex.py): your Discord user id.
# OWNER_DISCORD_ID=000000000000000000
